<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.dapa1.MyChat</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>MyChat</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/DaPa/MyChat">MyCompany</vendor>

    <!-- The description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <b>MyChat</b> integrates popular AI chat services (ChatGPT, Claude, Gemini, etc.)
        directly into your IDE via a tool window, enabling seamless file and code integration.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>

    <resource-bundle>messages.MyChatMessagesBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="MyChatWindow"
                factoryClass="com.dapa1.MyChatWindowFactory"
                anchor="right"
                icon="/icons/toolWindow.svg"
                secondary="false"
        />
        <applicationConfigurable
            instance="com.dapa1.settings.MyChatConfigurable"
            id="MyChatSettings"
            displayName="MyChat"
        />
        <!--
            PostStartupActivity runs after the IDE is fully initialized — all services
            including ProxyMigrationService are available by this point.
            This is used to safely initialize JCEF (JBCefApp) without triggering
            "Class initialization must not depend on services" during startup.
            DumbAware = runs even during indexing (no need to wait for smart mode).
        -->
        <postStartupActivity implementation="com.dapa1.MyChatStartupActivity"/>
        <jcef.appRequiredArgumentsProvider implementation="com.dapa1.MyChatCefArgsProvider"/>
        <notificationGroup id="MyChat.ThemeChangeNotification" displayType="STICKY_BALLOON"/>
        <notificationGroup id="MyChat.Notification" displayType="BALLOON" isLogByDefault="true"/>

    </extensions>

    <actions>
        <action id="MyChat.FindInBrowser"
                class="com.dapa1.actions.FindInBrowserAction"
                text="Find in Chat"
                description="Find"
                icon="AllIcons.Actions.Search">// for all icons, see https://intellij-icons.jetbrains.design/
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl F"/>
        </action>

        <action id="MyChat.FindInBrowserNext"
                class="com.dapa1.actions.FindInBrowserNextAction"
                text="Find Next"
                description="Find next"
                icon="AllIcons.General.ChevronDown">
            <keyboard-shortcut keymap="$default" first-keystroke="F3"/>
        </action>

        <action id="MyChat.FindInBrowserPrevious"
                class="com.dapa1.actions.FindInBrowserPreviousAction"
                text="Find Previous"
                description="Find previous"
                icon="AllIcons.General.ChevronUp">
            <keyboard-shortcut keymap="$default" first-keystroke="shift F3"/>
        </action>

        <action id="MyChat.Back"
                class="com.dapa1.actions.BackAction"
                text="Back"
                description="Go back"
                icon="AllIcons.Actions.Back">
            <keyboard-shortcut keymap="$default" first-keystroke="alt LEFT"/>
        </action>

        <action id="MyChat.Forward"
                class="com.dapa1.actions.ForwardAction"
                text="Forward"
                description="Go forward"
                icon="AllIcons.Actions.Forward">
            <keyboard-shortcut keymap="$default" first-keystroke="alt RIGHT"/>
        </action>

        <action id="MyChat.Stop"
                class="com.dapa1.actions.StopAction"
                text="Stop"
                description="Stop the current operation"
                icon="AllIcons.Actions.Suspend">
            <keyboard-shortcut keymap="$default" first-keystroke="ESCAPE"/>
        </action>

        <action id="MyChat.Refresh"
                class="com.dapa1.actions.RefreshAction"
                text="Refresh"
                description="Reload the current page"
                icon="AllIcons.Actions.Refresh">
            <keyboard-shortcut keymap="$default" first-keystroke="F5"/>
        </action>

        <action id="MyChat.Home"
                class="com.dapa1.actions.HomeAction"
                text="Home"
                description="Go to the home page"
                icon="AllIcons.Nodes.HomeFolder">
            <keyboard-shortcut keymap="$default" first-keystroke="alt HOME"/>
        </action>

        <action id="MyChat.ClearCookies"
                class="com.dapa1.actions.ClearCookiesAction"
                text="Clear Cookies"
                description="Clear all cookies"
                icon="AllIcons.Actions.GC">
            <keyboard-shortcut keymap="$default" first-keystroke="alt DELETE"/>
        </action>

        <action id="MyChat.Debug"
                class="com.dapa1.actions.DebugAction"
                text="Debug"
                description="Open CEF DevTools in the internal browser"
                icon="AllIcons.Actions.StartDebugger">
            <keyboard-shortcut keymap="$default" first-keystroke="F12"/>
        </action>

        <action id="MyChat.OpenSettings"
                class="com.dapa1.actions.OpenMyChatSettingsAction"
                text="MyChat Settings"
                description="Open the IDE settings and jump to other settings -> myChat"
                icon="AllIcons.General.Settings">
            <keyboard-shortcut keymap="$default" first-keystroke="alt F1"/>
        </action>

        <action id="MyChat.OpenKeymap"
                class="com.dapa1.actions.OpenMyChatKeymapAction"
                text="MyChat Keymap"
                description="Go to IDE settings -> keymap -> plugins -> myChat"
                icon="AllIcons.General.Keyboard">
            <keyboard-shortcut keymap="$default" first-keystroke="alt F2"/>
        </action>

        <group id="MyChat.PopupGroup"
               text="MyChat"
               popup="true"
               icon="/icons/toolWindow.svg">

            <!-- Add the submenu to the desired context menus -->
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>

            <action id="MyChat.SendToMyChat"
                    class="com.dapa1.actions.SendToMyChatAction"
                    text="Send to Chat"
                    description="Send the current file to the MyChat browser"
                    icon="AllIcons.Actions.Upload">
                <keyboard-shortcut keymap="$default" first-keystroke="alt M"/>
            </action>

            <action id="MyChat.EmbedToMyChat"
                    class="com.dapa1.actions.EmbedToMyChatAction"
                    text="Embed to Chat"
                    description="Embed the current file to the MyChat browser"
                    icon="AllIcons.Actions.Upload">
                <keyboard-shortcut keymap="$default" first-keystroke="alt E"/>
            </action>

        </group>

    </actions>

</idea-plugin>
